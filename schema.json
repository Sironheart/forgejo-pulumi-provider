    "forgejo:index:OrganizationTeam": {
      "description": "A Forgejo organization team.",
      "properties": {
        "canCreateOrgRepo": {
          "type": "boolean",
          "description": "Whether team members can create organization repositories."
        },
        "description": {
          "type": "string",
          "description": "Team description."
        },
        "includesAllRepositories": {
          "type": "boolean",
          "description": "Whether the team includes all organization repositories."
        },
        "name": {
          "type": "string",
          "description": "Team name."
        },
        "organization": {
          "type": "string",
          "description": "Organization username/slug."
        },
        "permission": {
          "type": "string",
          "description": "Team repository permission: read, write, or admin.",
          "default": "read"
        },
        "teamId": {
          "type": "integer"
        },
        "unitsMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Per-repository-unit permissions, for example repo.code=read or repo.issues=write."
        }
      },
      "required": [
        "organization",
        "name",
        "teamId"
      ],
      "inputProperties": {
