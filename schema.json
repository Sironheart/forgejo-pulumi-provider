    "forgejo:index:RepositoryBranchProtection": {
      "description": "A Forgejo branch protection rule for a repository.",
      "properties": {
        "approvalsWhitelistTeams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Teams whose approvals count."
        },
        "approvalsWhitelistUsernames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Users whose approvals count."
        },
        "blockOnOfficialReviewRequests": {
          "type": "boolean",
          "description": "Whether official review requests block merging."
        },
        "blockOnOutdatedBranch": {
          "type": "boolean",
          "description": "Whether outdated branches block merging."
        },
        "blockOnRejectedReviews": {
          "type": "boolean",
          "description": "Whether rejected reviews block merging."
        },
        "created": {
          "type": "string"
        },
        "dismissStaleApprovals": {
          "type": "boolean",
          "description": "Whether stale approvals are dismissed after new commits."
        },
        "enableApprovalsWhitelist": {
          "type": "boolean",
          "description": "Whether review approvals are limited to the approval whitelist."
        },
        "enableMergeWhitelist": {
          "type": "boolean",
          "description": "Whether merging is limited to the merge whitelist."
        },
        "enablePush": {
          "type": "boolean",
          "description": "Whether protected branches can be pushed to directly."
        },
        "enablePushWhitelist": {
          "type": "boolean",
          "description": "Whether direct pushes are limited to the push whitelist."
        },
        "enableStatusCheck": {
          "type": "boolean",
          "description": "Whether status checks are required before merge."
        },
        "mergeWhitelistTeams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Teams allowed to merge."
        },
        "mergeWhitelistUsernames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Users allowed to merge."
        },
        "name": {
          "type": "string",
          "description": "Protected branch name or rule pattern."
        },
        "owner": {
          "type": "string",
          "description": "Repository owner."
        },
        "protectedFilePatterns": {
          "type": "string",
          "description": "Protected file patterns."
        },
        "pushWhitelistDeployKeys": {
          "type": "boolean",
          "description": "Whether deploy keys may push directly."
        },
        "pushWhitelistTeams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Teams allowed to push directly."
        },
        "pushWhitelistUsernames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Users allowed to push directly."
        },
        "repository": {
          "type": "string",
          "description": "Repository name."
        },
        "requireSignedCommits": {
          "type": "boolean",
          "description": "Whether commits must be signed."
        },
        "requiredApprovals": {
          "type": "integer",
          "description": "Number of required approving reviews."
        },
        "statusCheckContexts": {
          "type": "array",
          "items": {
