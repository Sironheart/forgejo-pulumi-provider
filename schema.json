{
  "name": "forgejo",
  "displayName": "Forgejo Pulumi Provider",
  "version": "0.3.0",
  "description": "A Pulumi provider for managing Forgejo resources.",
  "keywords": [
    "pulumi",
    "forgejo",
    "git",
    "gitea"
  ],
  "homepage": "https://forgejo.siron.casa/sironheart/forgejo-pulumi-provider",
  "license": "Apache-2.0",
  "repository": "https://forgejo.siron.casa/sironheart/forgejo-pulumi-provider",
  "pluginDownloadURL": "https://forgejo.siron.casa/sironheart/forgejo-pulumi-provider/releases/download/v${VERSION}/",
  "publisher": "sironheart",
  "language": {
    "csharp": {
      "rootNamespace": "Pulumi"
    },
    "go": {
      "importBasePath": "forgejo.siron.casa/sironheart/forgejo-pulumi-provider/sdk/go",
      "modulePath": "sdk/go",
      "rootPackageName": "forgejo-pulumi-provider"
    },
    "java": {
      "basePackage": "casa.siron.forgejo",
      "buildFiles": "gradle"
    },
    "nodejs": {
      "packageDescription": "A Pulumi provider for managing Forgejo resources.",
      "packageName": "@sironheart/pulumi-forgejo-provider",
      "respectSchemaVersion": true
    }
  },
  "config": {
    "variables": {
      "token": {
        "type": "string",
        "description": "Forgejo API token. Can also be set with FORGEJO_TOKEN.",
        "defaultInfo": {
          "environment": [
            "FORGEJO_TOKEN"
          ]
        },
        "secret": true
      },
      "url": {
        "type": "string",
        "description": "Base URL of the Forgejo instance. Can also be set with FORGEJO_URL.",
        "defaultInfo": {
          "environment": [
            "FORGEJO_URL"
          ]
        }
      }
    },
    "defaults": [
      "url",
      "token"
    ]
  },
  "types": {
    "forgejo:index:RepositorySettingsConfig": {
      "properties": {
        "actions": {
          "type": "boolean",
          "description": "Whether the actions unit is enabled. Leave unset to avoid managing it."
        },
        "externalTrackerFormat": {
          "type": "string",
          "description": "External issue tracker URL format. Forgejo supports placeholders such as {user}, {repo}, and {index}."
        },
        "externalTrackerRegexPattern": {
          "type": "string",
          "description": "External issue tracker regular expression pattern."
        },
        "externalTrackerStyle": {
          "type": "string",
          "description": "External issue tracker number style, for example numeric or alphanumeric."
        },
        "externalTrackerUrl": {
          "type": "string",
          "description": "External issue tracker URL. Setting this also enables issues unless issues is explicitly set."
        },
        "externalWikiUrl": {
          "type": "string",
          "description": "External wiki URL. Setting this also enables the wiki unless wiki is explicitly set."
        },
        "globallyEditableWiki": {
          "type": "boolean",
          "description": "Whether the wiki is globally editable."
        },
        "internalTrackerAllowOnlyContributorsToTrackTime": {
          "type": "boolean",
          "description": "Whether only contributors may track time in the internal issue tracker."
        },
        "internalTrackerEnableIssueDependencies": {
          "type": "boolean",
          "description": "Whether issue dependencies are enabled in the internal issue tracker."
        },
        "internalTrackerEnableTimeTracker": {
          "type": "boolean",
          "description": "Whether the internal issue tracker has time tracking enabled."
        },
        "issues": {
          "type": "boolean",
          "description": "Whether the issue tracker unit is enabled. Leave unset to avoid managing it."
        },
        "packages": {
          "type": "boolean",
          "description": "Whether the packages unit is enabled. Leave unset to avoid managing it."
        },
        "projects": {
          "type": "boolean",
          "description": "Whether the projects unit is enabled. Leave unset to avoid managing it."
        },
        "pullRequests": {
          "type": "boolean",
          "description": "Whether the pull request unit is enabled. Leave unset to avoid managing it."
        },
        "releases": {
          "type": "boolean",
          "description": "Whether the releases unit is enabled. Leave unset to avoid managing it."
        },
        "wiki": {
          "type": "boolean",
          "description": "Whether the wiki unit is enabled. Leave unset to avoid managing it."
        },
        "wikiBranch": {
          "type": "string",
          "description": "Branch used for the repository wiki."
        }
      },
      "type": "object"
    }
  },
  "provider": {
    "properties": {
      "token": {
        "type": "string",
        "description": "Forgejo API token. Can also be set with FORGEJO_TOKEN.",
        "defaultInfo": {
          "environment": [
            "FORGEJO_TOKEN"
          ]
        },
        "secret": true
      },
      "url": {
        "type": "string",
        "description": "Base URL of the Forgejo instance. Can also be set with FORGEJO_URL.",
        "defaultInfo": {
          "environment": [
            "FORGEJO_URL"
          ]
        }
      }
    },
    "required": [
      "url",
      "token"
    ],
    "inputProperties": {
      "token": {
        "type": "string",
        "description": "Forgejo API token. Can also be set with FORGEJO_TOKEN.",
        "defaultInfo": {
          "environment": [
            "FORGEJO_TOKEN"
          ]
        },
        "secret": true
      },
      "url": {
        "type": "string",
        "description": "Base URL of the Forgejo instance. Can also be set with FORGEJO_URL.",
        "defaultInfo": {
          "environment": [
            "FORGEJO_URL"
          ]
        }
      }
    },
    "requiredInputs": [
      "url",
      "token"
    ]
  },
  "resources": {
    "forgejo:index:DeployKey": {
      "description": "A Forgejo deploy key for a repository.",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "OpenSSH public key material."
        },
        "keyId": {
          "type": "integer"
        },
        "owner": {
          "type": "string",
          "description": "Repository owner."
        },
        "readOnly": {
          "type": "boolean",
          "description": "Whether the deploy key is read-only.",
          "default": true
        },
        "repository": {
          "type": "string",
          "description": "Repository name."
        },
        "title": {
          "type": "string",
          "description": "Deploy key title."
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "owner",
        "repository",
        "title",
        "key",
        "keyId",
        "url",
        "fingerprint"
      ],
      "inputProperties": {
        "key": {
          "type": "string",
          "description": "OpenSSH public key material."
        },
        "owner": {
          "type": "string",
          "description": "Repository owner."
        },
        "readOnly": {
          "type": "boolean",
          "description": "Whether the deploy key is read-only.",
          "default": true
        },
        "repository": {
          "type": "string",
          "description": "Repository name."
        },
        "title": {
          "type": "string",
          "description": "Deploy key title."
        }
      },
      "requiredInputs": [
        "owner",
        "repository",
        "title",
        "key"
      ]
    },
    "forgejo:index:Organization": {
      "description": "A Forgejo organization.",
      "properties": {
        "avatarUrl": {
          "type": "string"
