            "type": "string"
          },
          "description": "Per-repository-unit permissions, for example repo.code=read or repo.issues=write."
        }
      },
      "requiredInputs": [
        "organization",
        "name"
      ]
    },
    "forgejo:index:OrganizationTeamMember": {
      "description": "A Forgejo organization team membership.",
      "properties": {
        "organization": {
          "type": "string",
          "description": "Organization username/slug. Required when teamId is not set."
        },
        "team": {
          "type": "string",
          "description": "Team name. Required when teamId is not set."
        },
        "teamId": {
          "type": "integer",
          "description": "Numeric Forgejo team ID. If omitted, organization and team are used to look up the team."
        },
        "userId": {
          "type": "integer"
        },
        "username": {
          "type": "string",
          "description": "Username to add to the team."
        }
      },
      "required": [
        "username",
        "userId"
      ],
      "inputProperties": {
        "organization": {
          "type": "string",
