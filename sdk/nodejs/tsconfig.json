{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "deployKey.ts",
        "getCurrentUser.ts",
        "index.ts",
        "organization.ts",
        "organizationActionSecret.ts",
        "organizationActionVariable.ts",
        "organizationTeam.ts",
        "organizationTeamMember.ts",
        "provider.ts",
        "publicKey.ts",
        "repository.ts",
        "repositoryActionSecret.ts",
        "repositoryActionVariable.ts",
        "repositoryBranchProtection.ts",
        "repositoryPushMirror.ts",
        "repositorySettings.ts",
        "repositoryTagProtection.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
