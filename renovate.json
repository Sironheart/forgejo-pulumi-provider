{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions"
  ],
  "packageRules": [
    {
      "description": "Group pulumi/pulumi updates into a single PR and keep versions in sync across all managers",
      "groupName": "pulumi",
      "matchPackageNames": [
        "github.com/pulumi/pulumi{/,}**",
        "pulumi/pulumi",
        "pulumi",
        "@pulumi/pulumi",
        "Pulumi",
        "com.pulumi:pulumi"
      ],
      "matchSourceUrls": [
        "https://github.com/pulumi/pulumi{/,}**"
      ]
    },
    {
      "description": "Keep workflow .NET SDK on 8.x",
      "matchDatasources": ["dotnet-version"],
      "matchPackageNames": ["dotnet-sdk"],
      "allowedVersions": "/^8\\./"
    },
    {
      "description": "Keep workflow Java on 11.x",
      "matchDatasources": ["java-version"],
      "matchPackageNames": ["java"],
      "allowedVersions": "/^11\\./"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/sdk/**"
  ],
  "npm": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "**/tests/**",
      "**/__fixtures__/**",
      "**/sdk/**"
    ]
  },
  "gradle": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "**/tests/**",
      "**/__fixtures__/**",
      "**/sdk/**"
    ]
  },
  "nuget": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__fixtures__/**",
      "**/sdk/**"
    ]
  }
}
